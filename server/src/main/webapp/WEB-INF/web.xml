<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Building defects server</display-name>

    <servlet>
        <servlet-name>BuildingObjectServlet</servlet-name>
        <servlet-class>ua.nupp.defects.servlet.BuildingObjectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BuildingObjectServlet</servlet-name>
        <url-pattern>/objects</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InspectionServlet</servlet-name>
        <servlet-class>ua.nupp.defects.servlet.InspectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InspectionServlet</servlet-name>
        <url-pattern>/inspections</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DefectServlet</servlet-name>
        <servlet-class>ua.nupp.defects.servlet.DefectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DefectServlet</servlet-name>
        <url-pattern>/defects</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RepairTaskServlet</servlet-name>
        <servlet-class>ua.nupp.defects.servlet.RepairTaskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RepairTaskServlet</servlet-name>
        <url-pattern>/tasks</url-pattern>
    </servlet-mapping>
</web-app>
